VITE_GOOGLE_MAPS_KEY=your-browser-key

# Square card form (Developer Dashboard > your app > Credentials and Locations). Use sandbox while testing.
VITE_SQUARE_ENV=sandbox
VITE_SQUARE_APP_ID=your-square-application-id
VITE_SQUARE_LOCATION_ID=your-square-location-id

# Set to off to show only the poster image instead of the video
VITE_HERO_VIDEO=on
