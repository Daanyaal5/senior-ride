PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Business details used in emails
BUSINESS_NAME=Halifax Accessible, Mobility, and Airport Transfers
BUSINESS_EMAIL=where-new-bookings-should-go@gmail.com
BUSINESS_PHONE=902-441-2015
ETRANSFER_EMAIL=email-that-receives-e-transfers@example.com

# Email sending (free).
# Testing with Mailpit on your computer: SMTP_HOST=localhost, SMTP_PORT=1025, leave SMTP_USER and SMTP_PASS empty.
# Real emails with Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail, SMTP_PASS=a Gmail app password.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Square (Developer Dashboard > your app > Credentials and Locations). Use sandbox while testing.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id

# Shows the real error on the page while testing. Remove before launch.
DEBUG_ERRORS=true